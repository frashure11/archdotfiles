// Load with --config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " -> ",
        "constants": [
            "──────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "key": "Hostname{#keys}",
            "type": "command",
            "text": "hostnamectl --static 2>/dev/null || hostname"
        },
        {
            "key": "Boot Time{#keys}",
            "type": "command",
            "text": "bt=$(systemd-analyze 2>/dev/null | awk -F'= ' '{print $2}' | awk '{print $1}'); echo ${bt:-N/A}"
        },

        {
            "key": "OS Age{#keys}",
            "type": "command",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progress=$((current - birth_install)); echo \"$((time_progress / 86400)) days\""
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        },
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "90"
        },
        {
            "type": "chassis",
            "key": "󰌢 PC",
            "keyColor": "green"
        },
        {
            "type": "host",
            "key": "│ ├Motherboard",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├CPU",
            "keyColor": "green",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": "│ ├GPU",
            "keyColor": "green",
            "format": "{name} ({3})"
        },
        {
            "type": "memory",
            "key": "│ ├RAM",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "│ └Display",
            "keyColor": "green"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "bootmgr",
            "key": "│ ├Boot Manager",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "│ ├WM",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ ├Shell",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ └Packages",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "90"
        },
        "break",
        {
            "type": "custom",
            "format": " {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}       {#38}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        }
    ]
}
